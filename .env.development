PORT=
CORS_ORIGIN=

# Vault is fail-closed and disabled unless every backend gate is configured.
VAULT_ENABLED=false
# Required only when VAULT_ENABLED=true. Must be HTTPS outside localhost.
VAULT_SUPABASE_URL=
VAULT_SUPABASE_ANON_KEY=
# Required when VAULT_ENABLED=true; used only for revoke/expire control-plane calls.
VAULT_CONTROL_PLANE_TOKEN=
VAULT_CAPABILITY_RESOLVE_TIMEOUT_MS=5000
VAULT_MAX_PAYLOAD_BYTES=1048576
